<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    
    <!-- Camera permission -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false" tools:replace="android:required"/>
    <!-- Scanning uses still images with audio disabled. CameraX otherwise
         merges recording/storage permissions intended for video capture. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <!-- Only pre-scoped-storage Android needs this to save public PDFs. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" tools:replace="android:maxSdkVersion"/>
    
    <!-- Photos are selected through the system picker; no broad media access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>

    <!-- The Files tab lists every PDF on the device, which is what a document
         reader is for. Android 11+ gates that behind All files access; older
         releases only need READ_EXTERNAL_STORAGE. Android 10 also needs
         requestLegacyExternalStorage for direct document discovery.

         Both are optional at runtime: without them the app still works and
         the Files tab shows its own documents, says so, and offers the grant.

         Play Console note: MANAGE_EXTERNAL_STORAGE requires a Permissions
         Declaration. The applicable use case is "File manager / document
         management app" — see the release checks in docs/PRODUCTION_AUDIT_2026-10-07.md. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>

    <!-- Notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    
    <application
        android:label="DocHelper"
        android:name="${applicationName}"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Trampoline: captures which alias was used, forwards to MainActivity with action extra -->
        <activity
            android:name=".PdfIntentTrampolineActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The app's single "Open with" entry. Opening a document from
             another app means one thing — read it — so the chooser gets one
             row labelled with the app's name, not a menu of verbs. Merge,
             split and the rest are reached from the screen's own actions once
             the document is on screen.

             It covers every kind DocHelper can open: PDFs, and plain text
             (other kinds join as their editors arrive; keep this in step with
             OPENABLE_EXTENSIONS in MainActivity). The component keeps its old
             name: renaming it would reset the "Always open with" choices
             people have made. -->
        <activity-alias
            android:name=".ViewPdfAlias"
            android:targetActivity=".PdfIntentTrampolineActivity"
            android:exported="true"
            android:label="DocHelper">
            <meta-data
                android:name="com.yourmateapps.pdfhelper.PDF_ACTION"
                android:value="view"/>
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:mimeType="application/pdf"/>
            </intent-filter>
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:pathPattern=".*\\.pdf"/>
            </intent-filter>
            <!-- Plain text, Markdown and JSON. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="text/markdown"/>
                <data android:mimeType="text/x-markdown"/>
                <data android:mimeType="application/json"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:pathPattern=".*\\.txt"/>
                <data android:pathPattern=".*\\.md"/>
                <data android:pathPattern=".*\\.json"/>
                <data android:pathPattern=".*\\.log"/>
            </intent-filter>
            <!-- Spreadsheets: Excel, OpenDocument, CSV and TSV. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.template"/>
                <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12"/>
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet"/>
                <data android:mimeType="text/csv"/>
                <data android:mimeType="text/comma-separated-values"/>
                <data android:mimeType="application/csv"/>
                <data android:mimeType="text/tab-separated-values"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:pathPattern=".*\\.xlsx"/>
                <data android:pathPattern=".*\\.xlsm"/>
                <data android:pathPattern=".*\\.ods"/>
                <data android:pathPattern=".*\\.csv"/>
                <data android:pathPattern=".*\\.tsv"/>
            </intent-filter>
        </activity-alias>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Production AdMob application; debug uses Google test ad units. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2596031675923197~6127791234"/>
            
        <!-- Do not collect crash reports until Flutter enables release reporting. -->
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false"/>

        <!-- Sharing/opening use share_plus and open_file's own providers. -->
    </application>
    
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/pdf"/>
        </intent>
        <!-- "Open with another app" for kinds DocHelper cannot open yet. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="*/*"/>
        </intent>
        <!-- url_launcher: opening external URLs (Rate App, Privacy, Terms) -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>
</manifest>
